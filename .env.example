# ─────────────────────────────────────────────
# Personal AI Astrologer — Environment Config
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_ENV=development
APP_NAME="Personal AI Astrologer"
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=DEBUG

# ── Security ─────────────────────────────────
SECRET_KEY=CHANGE-ME-generate-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://astrologer:astrologer@postgres:5432/astrologer
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10

# ── Redis ────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# ── Celery ───────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── AI Provider ──────────────────────────────
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Astrology ────────────────────────────────
EPHEMERIS_PATH=
DEFAULT_HOUSE_SYSTEM=placidus
DEFAULT_AYANAMSA=lahiri

# ── Geocoding ────────────────────────────────
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
NOMINATIM_USER_AGENT=personal-ai-astrologer/0.1.0

# ── Voice ────────────────────────────────────
STT_PROVIDER=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=

# ── Storage ──────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_BUCKET=

# ── Notifications ────────────────────────────
NOTIFICATION_PROVIDER=

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_CHART=10/minute
RATE_LIMIT_VOICE=10/minute
RATE_LIMIT_REPORT=5/minute
